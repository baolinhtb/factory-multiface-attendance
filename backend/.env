DB_NAME=postgres
DB_USER=postgres
DB_PASS=123456
DB_HOST=localhost
DB_PORT=5433

# Security Configuration
# IMPORTANT: Change this to a secure random string in production!
JWT_SECRET_KEY=your-secret-key-change-this-in-production-minimum-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
# List of allowed origins (comma-separated). Use http://localhost:3000 for dev, your domain for prod
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pose Matching Configuration
POSE_MATCHING_FRAME_SKIP=5
POSE_MATCHING_THRESHOLD=100
POSE_AREA_RATIO_THRESHOLD=0.5
POSE_REVERIFY_INTERVAL=2.0
POSE_STALE_TIMEOUT=20.0
POSE_CACHE_EXPIRY=30.0
POSE_MATCHING_ALGORITHM=hybrid
POSE_STALE_DISPLAY=possible

